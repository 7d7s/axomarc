# Kelson platform — developer commands (G01)

default: dev

# one-command dev environment
dev:
    docker compose up -d
    cargo run -p kelson-demo

check:
    cargo check --workspace
    cargo test --workspace
    cargo run -p xtask -- dep-rules

fmt:
    cargo fmt --all

lint:
    cargo clippy --workspace -- -D warnings

db-up:
    docker compose up -d

db-down:
    docker compose down

migrate:
    cargo run -p kelson-demo -- --migrate-only

# --- release engineering (see PUBLISHING.md) ---

# package + validate all publishable crates without uploading
publish-dry:
    cargo run -p xtask -- publish --dry-run

# publish all publishable crates to crates.io (requires `cargo login`)
publish:
    cargo run -p xtask -- publish

# bump the lockstep workspace version (MAJOR.MINOR.PATCH)
bump VERSION:
    cargo run -p xtask -- bump {{VERSION}}

# supply-chain gate (`cargo install cargo-deny`): advisories, licenses, bans, sources
deny:
    cargo deny check

# --- documentation gates (see docs/20-ARCHITECTURE-VERIFICATION.md §1) ---

# the citation gate: every `file:line` in a ledger document must resolve in
# the tree it names, and must say what its sentence says
cite-audit:
    cargo run --manifest-path keel-platform/Cargo.toml -p xtask -- cite-audit platform/docs/20-ARCHITECTURE-VERIFICATION.md platform/CHANGELOG.md platform/PUBLISHING.md

# the same gate over any other document: `just cite-audit-doc platform/docs/13-OPERATIONS.md`
cite-audit-doc +DOC:
    cargo run --manifest-path keel-platform/Cargo.toml -p xtask -- cite-audit {{DOC}}

# regenerate CHANGELOG.md at a release tag (`cargo install git-cliff`)
# example: just changelog kelson/platform-v0.1.0
changelog TAG:
    git cliff --config cliff.toml --tag {{TAG}} --output CHANGELOG.md
